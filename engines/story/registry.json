    {
      "id": "recap",
      "name": "Recap",
      "description": "A narrated vertical recap of a film or story idea over licensed stock footage, with karaoke captions and a poster ending.",
      "inputs": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Movie title or story idea"
        }
      ],
      "paidServices": [
        "gemini-llm",
        "gemini-tts",
        "groq-llm-fallback"
      ],
      "freeServices": [
        "wikipedia",
        "tmdb",
        "pexels"
      ],
      "localTools": [
        "ffmpeg",
        "openai-whisper"
      ],
      "formats": [
        "movie-recap",
        "story-recap"
      ]
    },
    {
      "id": "series",
      "name": "Series",
      "description": "A multi-episode AI-animated short series: story, characters, worlds, shot prompts and generated video clips per episode.",
      "inputs": [
        {
          "name": "title",
          "type": "string",
          "required": true,
          "description": "Project title"
        },
        {
          "name": "brief",
          "type": "string",
          "required": true,
          "description": "One to three sentence story brief"
        },
        {
          "name": "episodes",
          "type": "integer",
          "required": false,
          "description": "Number of episodes (1-10, default 1)"
        }
      ],
      "paidServices": [
        "gemini-llm",
        "gemini-image",
        "gemini-veo",
        "fal-ai"
      ],
      "freeServices": [],
      "localTools": [
        "ffmpeg"
      ],
      "formats": [
        "animated-short"
      ]
    }
  ],
