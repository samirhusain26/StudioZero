# StudioZero Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# API KEYS (Required for video generation)
# =============================================================================

# Groq API key for LLM script generation
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# TMDB API key for movie data fallback
# Get yours at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Pexels API key for stock video downloads
# Get yours at: https://www.pexels.com/api/
PEXELS_API_KEY=

# Google Gemini API key for text-to-speech
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# =============================================================================
# FAL.AI (optional: series video models other than Veo)
# =============================================================================

# FAL_KEY=

# =============================================================================
# OPTIONAL POLICIES
# =============================================================================

# Series: keep the video models' native audio (1, default) or request silent clips (0)
# SERIES_NATIVE_AUDIO=1

# Recap music: "catalog" (a CC0 track from engines/motion/music, default) or "none"
# RECAP_MUSIC=catalog
